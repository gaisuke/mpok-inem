INEM_DSN=postgres://inem@127.0.0.1:5432/inem?sslmode=disable
INEM_ADDR=127.0.0.1:8777
# The content engine (viral-content-engine) serves the editor's "rapikan dengan
# AI" call. inemd holds no model credential; it forwards and reports 502 when
# the engine is down. Default: http://127.0.0.1:8000
INEM_ENGINE_URL=http://127.0.0.1:8000
